# Contact form (src/pages/api/send-email.ts)
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. For testing you can use onboarding@resend.dev,
# which only delivers to your own Resend account email.
# For other recipients, verify your domain in Resend and use an address on it.
RESEND_FROM_EMAIL=onboarding@resend.dev

# The address that receives messages from the contact form.
RECEIVING_EMAIL=
